# =============================================================================
# CovenantWatch — copy to .env and fill in real values (never commit .env)
# =============================================================================

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=covenantwatch

# --- API server ---
PORT=5000
JWT_SECRET=generate-a-long-random-string-at-least-32-chars

# Optional: dedicated key for encrypting QuickBooks refresh tokens (defaults to JWT_SECRET)
# TOKEN_ENCRYPTION_KEY=

# Frontend URL for OAuth redirect after QuickBooks connect
FRONTEND_URL=http://localhost:5173

# --- QuickBooks / Intuit (https://developer.intuit.com) ---
QUICKBOOKS_CLIENT_ID=your_client_id_from_intuit
QUICKBOOKS_CLIENT_SECRET=your_client_secret_from_intuit
QUICKBOOKS_ENVIRONMENT=sandbox

# Must match Redirect URI in your Intuit app (Development → Keys & OAuth)
QUICKBOOKS_REDIRECT_URI=http://localhost:5000/api/integrations/quickbooks/callback

# Legacy single-company dev (optional — migrated into Mongo on first sync for default company)
# QUICKBOOKS_REALM_ID=your_company_realm_id
# QUICKBOOKS_REFRESH_TOKEN=your_refresh_token
QUICKBOOKS_DEFAULT_COMPANY_ID=acme

# --- Nightly QuickBooks sync (node-cron, runs inside API server) ---
ENABLE_QB_CRON=true
QB_CRON_SCHEDULE=0 2 * * *
QB_CRON_MAX_RUNS=4
# QB_CRON_TIMEZONE=America/New_York
QB_CRON_RUN_ON_START=false
